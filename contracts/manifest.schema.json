{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://room-alignment.local/contracts/manifest.schema.json",
  "title": "Room Alignment provenance manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "manifestCanonicalization", "artifact", "project", "renderPlan", "sourceSetDigest", "provenanceResolutions",
    "selectionSnapshot", "alignment", "composition", "sources", "outputTimebase", "videoSlices", "audioSlices", "transforms", "warnings",
    "toolVersions", "fidelity", "manifestCanonicalContentSha256"
  ],
  "properties": {
    "schema": {"const": "room-alignment-provenance-manifest/v1"},
    "manifestCanonicalization": {
      "const": "room-alignment-canonical-json/v1",
      "description": "Digest procedure: omit manifestCanonicalContentSha256; serialize the remaining JSON with object keys recursively sorted by Unicode code point, arrays in source order, no insignificant whitespace, comma and colon separators, non-ASCII characters unescaped, and UTF-8 encoding without a BOM; then compute lowercase SHA-256. The raw final manifest-file SHA-256 is stored externally in Artifact.manifestDigest because a file cannot contain its own digest."
    },
    "artifact": {
      "type": "object",
      "required": ["id", "videoSha256", "manifestSha256", "manifestFileDigestRecordedInArtifactState"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "videoSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "manifestSha256": {"const": null, "description": "Raw final manifest-file SHA-256 is stored externally in Artifact.manifestDigest to avoid self-reference."},
        "manifestFileDigestRecordedInArtifactState": {"const": true}
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "revision", "provenanceRevision", "selectionDigest", "alignmentDigest", "timelineSectionsDigest"],
      "properties": {"id": {"type": "string"}, "revision": {"type": "integer"}, "provenanceRevision": {"type": "integer"}, "selectionDigest": {"type": "string"}, "alignmentDigest": {"type": "string"}, "timelineSectionsDigest": {"type": "string"}}
    },
    "renderPlan": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {"id": {"type": "string"}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "sourceSetDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenanceResolutions": {"type": "array", "items": {"type": "object"}},
    "selectionSnapshot": {"type": "object"},
    "alignment": {
      "type": "object", "additionalProperties": false, "required": ["digest", "clipTransforms"],
      "properties": {"digest": {"type": "string"}, "clipTransforms": {"type": "array", "items": {"type": "object"}}}
    },
    "composition": {
      "type": "object", "additionalProperties": false,
      "required": ["timelineSections", "timelineSectionsDigest", "programDraft", "syntheticSlates"],
      "properties": {
        "timelineSections": {"type": "array", "items": {"$ref": "./timeline.schema.json#/$defs/TimelineSection"}},
        "timelineSectionsDigest": {"type": "string"},
        "programDraft": {"type": ["object", "null"]},
        "syntheticSlates": {"type": "array", "items": {"type": "object"}}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "rootId", "libraryRelativePath", "size", "sha256"],
        "properties": {
          "assetId": {"type": "string"}, "rootId": {"type": ["string", "null"]}, "libraryRelativePath": {"type": "string"},
          "size": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "outputTimebase": {
      "type": "object", "additionalProperties": false, "required": ["unit", "intervals"],
      "properties": {"unit": {"const": "microseconds"}, "intervals": {"const": "half-open"}}
    },
    "videoSlices": {"type": "array", "items": {"$ref": "./domain.schema.json#/$defs/CompiledSourceSlice"}},
    "audioSlices": {"type": "array", "items": {"$ref": "./domain.schema.json#/$defs/CompiledAudioSlice"}},
    "transforms": {
      "type": "object",
      "required": ["profile", "container", "videoCodec", "audioCodec", "normalization", "sourceMediaUnchanged", "streamCopy", "decodedAndReencoded"],
      "properties": {
        "profile": {"enum": ["COMPATIBLE", "ARCHIVAL_LOSSLESS"]}, "container": {"type": "string"},
        "videoCodec": {"type": "string"}, "audioCodec": {"type": "string"}, "normalization": {"type": "object"},
        "sourceMediaUnchanged": {"const": true}, "streamCopy": {"type": "boolean"}, "decodedAndReencoded": {"type": "boolean"}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "toolVersions": {"type": "object", "required": ["application", "ffmpeg", "ffprobe"], "additionalProperties": {"type": "string"}},
    "fidelity": {
      "type": "object", "additionalProperties": false,
      "required": ["claim", "sourceFilesModified", "generatedSilenceDisclosed", "generatedSlateDisclosed"],
      "properties": {
        "claim": {"enum": ["compatible-reencode", "lossless-encode-after-processing"]},
        "sourceFilesModified": {"const": false}, "generatedSilenceDisclosed": {"type": "boolean"}, "generatedSlateDisclosed": {"type": "boolean"}
      }
    },
    "manifestCanonicalContentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://room-alignment.local/contracts/timeline.schema.json",
  "title": "Room Alignment evidence timeline and clustering resources",
  "$defs": {
    "Id": {"type": "string", "minLength": 1, "maxLength": 200},
    "Us": {"type": "integer", "minimum": 0},
    "SignedUs": {"type": "integer"},
    "LibraryRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "libraryId", "grantId", "label", "active", "createdAt"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "libraryId": {"$ref": "#/$defs/Id"},
        "grantId": {"$ref": "#/$defs/Id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "active": {"type": "boolean"},
        "timePolicyOverride": {"type": ["object", "null"]},
        "lastScanAt": {"type": ["string", "null"], "format": "date-time"},
        "createdAt": {"type": "string", "format": "date-time"},
        "revokedAt": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "CatalogRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "libraryId", "revision", "digest", "createdAt"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "libraryId": {"$ref": "#/$defs/Id"},
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "ClusterConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventGapUs", "sessionGapUs"],
      "properties": {
        "eventGapUs": {"type": "integer", "minimum": 0, "default": 15000000},
        "sessionGapUs": {"type": "integer", "minimum": 0, "default": 120000000}
      }
    },
    "ClusterFacet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "clipCount"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "clipCount": {"type": "integer", "minimum": 1}
      }
    },
    "ClusterFacets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationId", "roots", "sourceCandidates"],
      "properties": {
        "generationId": {"$ref": "#/$defs/Id"},
        "roots": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/ClusterFacet"}},
        "sourceCandidates": {"type": "array", "items": {"$ref": "#/$defs/ClusterFacet"}}
      }
    },
    "ClusterGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "libraryId", "catalogRevisionId", "catalogRevision", "jobId", "algorithm", "algorithmVersion", "config", "configDigest", "status", "sessionCount", "eventCount", "clusteredAssetCount", "unclusteredAssetCount", "message", "createdAt", "updatedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "libraryId": {"$ref": "#/$defs/Id"},
        "catalogRevisionId": {"$ref": "#/$defs/Id"},
        "catalogRevision": {"type": "integer", "minimum": 1},
        "jobId": {"$ref": "#/$defs/Id"},
        "algorithm": {"const": "coverage-gap-hierarchy"},
        "algorithmVersion": {"type": "string"},
        "config": {"$ref": "#/$defs/ClusterConfig"},
        "configDigest": {"type": "string"},
        "status": {"enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELED"]},
        "sessionCount": {"type": "integer", "minimum": 0},
        "eventCount": {"type": "integer", "minimum": 0},
        "clusteredAssetCount": {"type": "integer", "minimum": 0},
        "unclusteredAssetCount": {"type": "integer", "minimum": 0},
        "message": {"type": ["string", "null"]},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "ClusterSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generationId", "kind", "startUs", "endUs", "eventCount", "clipCount", "sourceCount", "rootCount", "warnings"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "generationId": {"$ref": "#/$defs/Id"},
        "parentSessionId": {"type": ["string", "null"]},
        "kind": {"enum": ["SESSION", "EVENT"]},
        "startUs": {"$ref": "#/$defs/Us"},
        "endUs": {"$ref": "#/$defs/Us"},
        "eventCount": {"type": "integer", "minimum": 0},
        "clipCount": {"type": "integer", "minimum": 1},
        "sourceCount": {"type": "integer", "minimum": 0},
        "rootCount": {"type": "integer", "minimum": 1},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ClusterMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "startUs", "endUs", "rootId", "sourceCandidateId", "warnings", "media"],
      "properties": {
        "assetId": {"$ref": "#/$defs/Id"},
        "startUs": {"$ref": "#/$defs/Us"},
        "endUs": {"$ref": "#/$defs/Us"},
        "rootId": {"type": ["string", "null"]},
        "sourceCandidateId": {"type": ["string", "null"]},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "media": {"$ref": "./domain.schema.json#/$defs/MediaAsset"}
      }
    },
    "UnclusteredMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "warnings", "media"],
      "properties": {
        "assetId": {"$ref": "#/$defs/Id"},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "media": {"$ref": "./domain.schema.json#/$defs/MediaAsset"}
      }
    },
    "ClusterGenerationPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "nextCursor"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/ClusterGeneration"}},
        "nextCursor": {"type": ["string", "null"]}
      }
    },
    "ClusterSummaryPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationId", "items", "nextCursor"],
      "properties": {
        "generationId": {"$ref": "#/$defs/Id"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/ClusterSummary"}},
        "nextCursor": {"type": ["string", "null"]}
      }
    },
    "ClusterMembershipPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationId", "clusterId", "items", "nextCursor"],
      "properties": {
        "generationId": {"$ref": "#/$defs/Id"},
        "clusterId": {"$ref": "#/$defs/Id"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/ClusterMembership"}},
        "nextCursor": {"type": ["string", "null"]}
      }
    },
    "UnclusteredMembershipPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationId", "items", "nextCursor"],
      "properties": {
        "generationId": {"$ref": "#/$defs/Id"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/UnclusteredMembership"}},
        "nextCursor": {"type": ["string", "null"]}
      }
    },
    "ProjectSelectionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterGenerationId", "selectedSessionIds", "selectedEventIds", "assetIds", "manualIncludeAssetIds", "manualExcludeAssetIds", "digest"],
      "properties": {
        "clusterGenerationId": {"type": ["string", "null"]},
        "selectedSessionIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
        "selectedEventIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
        "assetIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
        "manualIncludeAssetIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
        "manualExcludeAssetIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ClipAlignmentTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchorSourceUs", "anchorAlignedUs", "ratePpm"],
      "properties": {
        "anchorSourceUs": {"type": "integer"},
        "anchorAlignedUs": {"type": "integer"},
        "ratePpm": {"type": "integer", "minimum": -2000, "maximum": 2000}
      }
    },
    "TimelineSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startAlignedUs", "endAlignedUs", "mode"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "startAlignedUs": {"$ref": "#/$defs/SignedUs"},
        "endAlignedUs": {"$ref": "#/$defs/SignedUs"},
        "mode": {"enum": ["KEEP", "EXCLUDE", "SLATE"]},
        "slateText": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "TimelineSectionProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "projectRevision", "alignmentDigest", "gapMode", "sections", "keepDurationUs", "excludedDurationUs", "slateDurationUs", "outputDurationUs", "digest"],
      "properties": {
        "projectId": {"$ref": "#/$defs/Id"},
        "projectRevision": {"type": "integer", "minimum": 1},
        "alignmentDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gapMode": {"enum": ["EXCLUDE", "SLATE"]},
        "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/TimelineSection"}},
        "keepDurationUs": {"$ref": "#/$defs/Us"},
        "excludedDurationUs": {"$ref": "#/$defs/Us"},
        "slateDurationUs": {"$ref": "#/$defs/Us"},
        "outputDurationUs": {"$ref": "#/$defs/Us"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "AlignmentEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "confidence"],
      "properties": {
        "kind": {"enum": ["TIMESTAMP_PRIOR", "AUDIO_CORRELATION"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "otherClipId": {"$ref": "#/$defs/Id"},
        "correctionUs": {"$ref": "#/$defs/SignedUs"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "AlignmentProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "clipId", "assetId", "classification", "proposedAlignment", "confidence", "automaticallyAcceptable", "timestampPriorAcceptable", "requiresDriftConfirmation", "evidence", "limitations", "inputFingerprintDigest"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "clipId": {"$ref": "#/$defs/Id"},
        "assetId": {"$ref": "#/$defs/Id"},
        "logicalSourceId": {"$ref": "#/$defs/Id"},
        "componentId": {"type": ["string", "null"]},
        "classification": {"enum": ["AUDIO_CONFIRMED", "TIMESTAMP_ONLY", "CONFLICTING", "UNRESOLVED", "MANUAL_ACCEPTED"]},
        "proposedAlignment": {"$ref": "#/$defs/ClipAlignmentTransform"},
        "proposedEndAlignedUs": {"type": "integer"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "relativeConfidence": {"type": "number", "minimum": 0, "maximum": 1},
        "absoluteConfidence": {"type": "number", "minimum": 0, "maximum": 1},
        "residualUs": {"type": ["integer", "null"]},
        "supportingEdgeCount": {"type": "integer", "minimum": 0},
        "rejectedOutlierCount": {"type": "integer", "minimum": 0},
        "timestampUncertaintyUs": {"type": ["integer", "null"], "minimum": 0},
        "automaticallyAcceptable": {"type": "boolean"},
        "timestampPriorAcceptable": {"type": "boolean"},
        "requiresDriftConfirmation": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/AlignmentEvidence"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "inputFingerprintDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "AlignmentProposalSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audioConfirmed", "timestampOnly", "conflicting", "unresolved", "manualAccepted", "proposedDriftCorrections", "candidatePairs", "confirmedEdges", "signatureFailures", "analysisCapped"],
      "properties": {
        "audioConfirmed": {"type": "integer", "minimum": 0},
        "timestampOnly": {"type": "integer", "minimum": 0},
        "conflicting": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0},
        "manualAccepted": {"type": "integer", "minimum": 0},
        "proposedDriftCorrections": {"type": "integer", "minimum": 0},
        "candidatePairs": {"type": "integer", "minimum": 0},
        "confirmedEdges": {"type": "integer", "minimum": 0},
        "signatureFailures": {"type": "integer", "minimum": 0},
        "analysisCapped": {"type": "boolean"}
        ,"componentCount": {"type": "integer", "minimum": 0}
        ,"supportedComponentCount": {"type": "integer", "minimum": 0}
        ,"timestampAnchoredComponentCount": {"type": "integer", "minimum": 0}
        ,"floatingComponentCount": {"type": "integer", "minimum": 0}
        ,"rejectedOutlierCount": {"type": "integer", "minimum": 0}
      }
    },
    "AlignmentProposalSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "projectId", "projectRevision", "selectionDigest", "inputDigest", "digest", "algorithm", "algorithmVersion", "config", "configDigest", "status", "summary", "proposals", "limitations", "createdAt", "updatedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "projectId": {"$ref": "#/$defs/Id"},
        "projectRevision": {"type": "integer", "minimum": 1},
        "selectionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inputDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "algorithm": {"const": "bounded-audio-evidence-graph"},
        "algorithmVersion": {"type": "string", "minLength": 1},
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overlapSearchExtensionUs", "maxCandidatesPerClip", "maxPairComparisons", "signatureSampleRate", "signatureMaxSeconds", "visualMatching"],
          "properties": {
            "overlapSearchExtensionUs": {"type": "integer", "minimum": 0},
            "maxCandidatesPerClip": {"type": "integer", "minimum": 1},
            "maxPairComparisons": {"type": "integer", "minimum": 1},
            "signatureSampleRate": {"type": "integer", "minimum": 1},
            "signatureMaxSeconds": {"type": "integer", "minimum": 1},
            "visualMatching": {"const": false}
          }
        },
        "configDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["PENDING", "PARTIALLY_RESOLVED", "RESOLVED", "ACCEPTED", "REJECTED", "STALE", "SUPERSEDED"]},
        "summary": {"$ref": "#/$defs/AlignmentProposalSummary"},
        "proposals": {"type": "array", "items": {"$ref": "#/$defs/AlignmentProposal"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "acceptedProposalIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
        "rejectedProposalIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
        "invalidationReason": {"type": "string"},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "TimelineClipItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "clipId", "assetId", "logicalSourceId", "startAlignedUs", "endAlignedUs", "alignmentState", "programEligibility", "confidence", "evidenceKinds", "relativePath", "warnings"],
      "properties": {
        "type": {"const": "CLIP"},
        "clipId": {"$ref": "#/$defs/Id"},
        "assetId": {"$ref": "#/$defs/Id"},
        "logicalSourceId": {"$ref": "#/$defs/Id"},
        "startAlignedUs": {"$ref": "#/$defs/SignedUs"},
        "endAlignedUs": {"$ref": "#/$defs/SignedUs"},
        "alignmentState": {"enum": ["PROVISIONAL", "ACCEPTED", "REVIEW_REQUIRED", "UNRESOLVED"]},
        "programEligibility": {"enum": ["ELIGIBLE", "HELD_FOR_REVIEW", "EXCLUDED"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidenceKinds": {"type": "array", "items": {"type": "string"}},
        "relativePath": {"type": "string"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "TimelineBucketItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "startAlignedUs", "endAlignedUs", "clipCount", "sourceCount", "logicalSourceIds", "stateCounts", "warningCount"],
      "properties": {
        "type": {"const": "BUCKET"},
        "startAlignedUs": {"$ref": "#/$defs/SignedUs"},
        "endAlignedUs": {"$ref": "#/$defs/SignedUs"},
        "clipCount": {"type": "integer", "minimum": 1},
        "sourceCount": {"type": "integer", "minimum": 1},
        "logicalSourceIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
        "stateCounts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "warningCount": {"type": "integer", "minimum": 0}
      }
    },
    "TimelineUnplacedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "clipId", "assetId", "logicalSourceId", "alignmentState", "relativePath", "warnings"],
      "properties": {
        "type": {"const": "UNPLACED"},
        "clipId": {"$ref": "#/$defs/Id"},
        "assetId": {"$ref": "#/$defs/Id"},
        "logicalSourceId": {"$ref": "#/$defs/Id"},
        "alignmentState": {"const": "UNRESOLVED"},
        "relativePath": {"type": "string"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "TimelineWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "revision", "startAlignedUs", "endAlignedUs", "resolutionUs", "mode", "items", "totalBeforeWindow", "totalInWindow", "unplacedCount", "unplacedItems", "alignmentDigest"],
      "properties": {
        "projectId": {"$ref": "#/$defs/Id"},
        "revision": {"type": "integer", "minimum": 1},
        "startAlignedUs": {"$ref": "#/$defs/SignedUs"},
        "endAlignedUs": {"$ref": "#/$defs/SignedUs"},
        "resolutionUs": {"type": "integer", "minimum": 1},
        "mode": {"enum": ["EXACT", "AGGREGATED"]},
        "items": {"type": "array", "maxItems": 2000, "items": {"oneOf": [{"$ref": "#/$defs/TimelineClipItem"}, {"$ref": "#/$defs/TimelineBucketItem"}]}},
        "totalBeforeWindow": {"type": "integer", "minimum": 0},
        "totalInWindow": {"type": "integer", "minimum": 0},
        "unplacedCount": {"type": "integer", "minimum": 0},
        "unplacedItems": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/TimelineUnplacedItem"}},
        "alignmentDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "AlignmentSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "revision", "alignmentDigest", "evidenceSpan", "proposedOutputDurationUs", "confidenceCounts", "eligibilityCounts", "coverage", "coverageIntervals", "blockers", "warnings", "conflicts", "unplacedClipIds", "readyForProgramDraft"],
      "properties": {
        "projectId": {"$ref": "#/$defs/Id"},
        "revision": {"type": "integer", "minimum": 1},
        "alignmentDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidenceSpan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startAlignedUs", "endAlignedUs", "durationUs"],
          "properties": {
            "startAlignedUs": {"$ref": "#/$defs/SignedUs"},
            "endAlignedUs": {"$ref": "#/$defs/SignedUs"},
            "durationUs": {"$ref": "#/$defs/Us"}
          }
        },
        "proposedOutputDurationUs": {"$ref": "#/$defs/Us"},
        "confidenceCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted", "provisional", "reviewRequired", "unresolved", "audioConfirmed", "timestampOnly"],
          "properties": {
            "accepted": {"type": "integer", "minimum": 0},
            "provisional": {"type": "integer", "minimum": 0},
            "reviewRequired": {"type": "integer", "minimum": 0},
            "unresolved": {"type": "integer", "minimum": 0},
            "audioConfirmed": {"type": "integer", "minimum": 0},
            "timestampOnly": {"type": "integer", "minimum": 0}
          }
        },
        "eligibilityCounts": {
          "type": "object", "additionalProperties": false,
          "required": ["eligible", "heldForReview", "excluded"],
          "properties": {
            "eligible": {"type": "integer", "minimum": 0},
            "heldForReview": {"type": "integer", "minimum": 0},
            "excluded": {"type": "integer", "minimum": 0}
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidenceCoverageUs", "acceptedCoverageUs", "unresolvedSoleCoverageUs", "acceptedPercent", "sourceCount"],
          "properties": {
            "evidenceCoverageUs": {"$ref": "#/$defs/Us"},
            "acceptedCoverageUs": {"$ref": "#/$defs/Us"},
            "unresolvedSoleCoverageUs": {"$ref": "#/$defs/Us"},
            "acceptedPercent": {"type": "number", "minimum": 0, "maximum": 100},
            "sourceCount": {"type": "integer", "minimum": 0}
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
              "required": ["code", "blocking"],
              "properties": {
              "code": {"type": "string"},
              "clipId": {"$ref": "#/$defs/Id"},
              "assetId": {"$ref": "#/$defs/Id"},
              "clipIds": {"type": "array", "items": {"$ref": "#/$defs/Id"}},
              "startAlignedUs": {"type": "integer"}, "endAlignedUs": {"type": "integer"},
              "remediationActions": {"type": "array", "items": {"type": "string"}},
              "blocking": {"type": "boolean"}
            }
          }
        },
        "coverageIntervals": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "blockers": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "warnings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "unplacedClipIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
        "readyForProgramDraft": {"type": "boolean"}
      }
    },
    "AlignedSourcePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "revision", "alignedUs", "validFromAlignedUs", "validUntilAlignedUs", "alignmentDigest", "sources"],
      "properties": {
        "projectId": {"$ref": "#/$defs/Id"},
        "revision": {"type": "integer", "minimum": 1},
        "alignedUs": {"type": "integer"},
        "validFromAlignedUs": {"type": "integer"},
        "validUntilAlignedUs": {"type": "integer"},
        "alignmentDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logicalSourceId", "status", "candidates"],
            "properties": {
              "logicalSourceId": {"$ref": "#/$defs/Id"},
              "status": {"enum": ["NO_COVERAGE", "AVAILABLE", "AMBIGUOUS"]},
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["clipId", "assetId", "relativePath", "startAlignedUs", "endAlignedUs", "sourceUs", "alignmentState", "alignmentConfidence", "alignmentEvidence"],
                  "properties": {
                    "clipId": {"$ref": "#/$defs/Id"}, "assetId": {"$ref": "#/$defs/Id"}, "relativePath": {"type": "string"},
                    "startAlignedUs": {"type": "integer"}, "endAlignedUs": {"type": "integer"}, "sourceUs": {"$ref": "#/$defs/Us"},
                    "alignmentState": {"enum": ["PROVISIONAL", "ACCEPTED", "REVIEW_REQUIRED", "UNRESOLVED"]},
                    "alignmentConfidence": {"type": "number", "minimum": 0, "maximum": 1},
                    "alignmentEvidence": {"type": "array", "items": {"type": "string"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "ProjectPreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "revision", "phase", "sourceIdentity", "alignment", "hasProgram", "programDurationUs", "legacyProgramTruncation", "canAnalyzeAlignment", "canGenerateProgramDraft", "compositionResolvesAlignment", "canEnterCut", "canEnterReview", "blockers"],
      "properties": {
        "projectId": {"$ref": "#/$defs/Id"},
        "revision": {"type": "integer", "minimum": 1},
        "phase": {"enum": ["SOURCE_REVIEW", "ALIGNMENT_REVIEW", "COMPOSITION_READY", "PROGRAM_DRAFT", "REVIEWED"]},
        "sourceIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ready", "confirmedCount", "provisionalCount", "provisionalSourceIds"],
          "properties": {
            "ready": {"type": "boolean"},
            "confirmedCount": {"type": "integer", "minimum": 0},
            "provisionalCount": {"type": "integer", "minimum": 0},
            "provisionalSourceIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}}
          }
        },
        "alignment": {"$ref": "#/$defs/AlignmentSummary"},
        "hasProgram": {"type": "boolean"},
        "programDurationUs": {"$ref": "#/$defs/Us"},
        "legacyProgramTruncation": {"type": "boolean"},
        "canAnalyzeAlignment": {"type": "boolean"},
        "canGenerateProgramDraft": {"type": "boolean"},
        "compositionResolvesAlignment": {"type": "boolean"},
        "canEnterCut": {"type": "boolean"},
        "canEnterReview": {"type": "boolean"},
        "blockers": {"type": "array", "items": {"type": "object", "required": ["code"], "properties": {"code": {"enum": ["SOURCE_IDENTITY_UNCONFIRMED", "ALIGNMENT_REVIEW_REQUIRED", "PROGRAM_TRUNCATES_ALIGNED_MEDIA"]}}, "additionalProperties": true}}
      }
    },
    "AudioWaveform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "available", "points"],
      "properties": {
        "assetId": {"$ref": "#/$defs/Id"},
        "available": {"type": "boolean"},
        "reason": {"type": "string"},
        "startSourceUs": {"$ref": "#/$defs/Us"},
        "endSourceUs": {"$ref": "#/$defs/Us"},
        "sampleRate": {"type": "integer", "minimum": 1},
        "pointDurationUs": {"type": "integer", "minimum": 1},
        "points": {"type": "array", "maxItems": 2000, "items": {"type": "integer", "minimum": 0, "maximum": 1000}},
        "truncated": {"type": "boolean"},
        "signatureDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ProgramDraftPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "projectId", "projectRevision", "selectionDigest", "alignmentDigest", "strategy", "videoBlocks", "audioBlocks", "outputDurationUs", "issues", "digest"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "projectId": {"$ref": "#/$defs/Id"},
        "projectRevision": {"type": "integer", "minimum": 1},
        "selectionDigest": {"type": "string"},
        "alignmentDigest": {"type": "string"},
        "strategy": {"const": "coverage-optimizer-v1"},
        "videoBlocks": {"type": "array", "items": {"$ref": "./domain.schema.json#/$defs/VideoBlock"}},
        "audioBlocks": {"type": "array", "items": {"$ref": "./domain.schema.json#/$defs/AudioBlock"}},
        "outputDurationUs": {"$ref": "#/$defs/Us"},
        "issues": {"type": "array", "items": {"$ref": "./domain.schema.json#/$defs/ProgramIssue"}},
        "digest": {"type": "string"}
      }
    },
    "SyntheticSlate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "videoGenerated", "audioMode", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "text": {"type": "string", "minLength": 1, "maxLength": 500},
        "videoGenerated": {"const": true},
        "audioMode": {"const": "SILENCE"},
        "provenance": {"type": "object"}
      }
    }
  }
}

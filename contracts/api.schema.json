{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://room-alignment.local/contracts/api.schema.json",
  "title": "Room Alignment HTTP API v1 resources",
  "$defs": {
    "ErrorEnvelope": {
      "type": "object", "additionalProperties": false, "required": ["error"],
      "properties": {"error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "requestId", "retryable", "details"], "properties": {
        "code": {"enum": ["VALIDATION_FAILED", "UNAUTHENTICATED", "FORBIDDEN", "NOT_FOUND", "REVISION_CONFLICT", "IDEMPOTENCY_CONFLICT", "GRANT_REQUIRED", "SOURCE_MISSING", "SOURCE_CHANGED", "COVERAGE_INVALID", "PROVENANCE_UNRESOLVED", "REVIEW_STALE", "PLAN_STALE", "DESTINATION_EXISTS", "INSUFFICIENT_SPACE", "JOB_STATE_CONFLICT", "UNSUPPORTED_MEDIA", "INTERNAL_ERROR"]},
        "message": {"type": "string"}, "requestId": {"type": "string"}, "retryable": {"type": "boolean"}, "details": {"type": "object"}
      }}}
    },
    "System": {"type": "object", "required": ["version", "apiVersion", "timeUnit", "intervals", "capabilities"], "properties": {"version": {"type": "string"}, "apiVersion": {"const": "v1"}, "timeUnit": {"const": "microseconds"}, "intervals": {"const": "half-open"}, "capabilities": {"type": "object", "additionalProperties": {"type": "boolean"}}}},
    "Session": {"type": "object", "additionalProperties": false, "required": ["authenticated", "csrfToken"], "properties": {"authenticated": {"const": true}, "csrfToken": {"type": "string", "minLength": 32}}},
    "GrantCreate": {"type": "object", "additionalProperties": false, "required": ["path", "role"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 4096}, "role": {"enum": ["READ_ONLY_SOURCE", "WRITE_OUTPUT"]}}},
    "LibraryCreate": {"type": "object", "additionalProperties": false, "required": ["sourceGrantId"], "properties": {"sourceGrantId": {"type": "string"}, "timeZone": {"type": "string", "default": "UTC"}, "dstFold": {"enum": [0, 1], "default": 0}, "nonexistentPolicy": {"enum": ["REJECT", "SHIFT_FORWARD"], "default": "REJECT"}}},
    "LibraryTimePolicy": {"type": "object", "additionalProperties": false, "required": ["timeZone"], "properties": {"timeZone": {"type": "string"}, "dstFold": {"enum": [0, 1]}, "nonexistentPolicy": {"enum": ["REJECT", "SHIFT_FORWARD"]}}},
    "Library": {"type": "object", "required": ["id", "sourceGrantId", "timeZone", "dstFold", "nonexistentPolicy", "currentGeneration"], "properties": {"id": {"type": "string"}, "sourceGrantId": {"type": "string"}, "timeZone": {"type": "string"}, "dstFold": {"enum": [0, 1]}, "nonexistentPolicy": {"enum": ["REJECT", "SHIFT_FORWARD"]}, "currentGeneration": {"type": "integer", "minimum": 0}}},
    "ScanStart": {"type": "object", "additionalProperties": false, "properties": {"mode": {"enum": ["INCREMENTAL", "FULL", "BOUNDED"], "default": "INCREMENTAL"}, "limit": {"type": "integer", "minimum": 1, "maximum": 10000000}}},
    "Scan": {"type": "object", "required": ["id", "libraryId", "generation", "mode", "status", "scanned", "videos", "warnings"], "properties": {"id": {"type": "string"}, "libraryId": {"type": "string"}, "generation": {"type": "integer", "minimum": 1}, "mode": {"enum": ["INCREMENTAL", "FULL", "BOUNDED"]}, "status": {"type": "string"}, "scanned": {"type": "integer"}, "videos": {"type": "integer"}, "warnings": {"type": "integer"}, "summary": {"type": "object"}}},
    "MediaPage": {"type": "object", "required": ["items", "nextCursor", "snapshotGeneration", "total"], "properties": {"items": {"type": "array", "items": {"$ref": "./domain.schema.json#/$defs/MediaAsset"}}, "nextCursor": {"type": ["string", "null"]}, "snapshotGeneration": {"type": "integer"}, "total": {"type": "integer"}}},
    "ProvenanceResolutionCreate": {"type": "object", "additionalProperties": false, "required": ["field", "resolution"], "properties": {"field": {"type": "string", "minLength": 1, "maxLength": 100}, "resolution": {"type": "object"}, "rationale": {"type": ["string", "null"], "maxLength": 500}}},
    "ProjectCreate": {"type": "object", "additionalProperties": false, "required": ["libraryId", "assetIds"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 200}, "libraryId": {"type": "string"}, "assetIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
    "CommandResult": {"type": "object", "required": ["commandId", "projectId", "previousRevision", "appliedRevision", "project", "issues", "reviewState", "eventCursor", "affectedIntervals"], "properties": {"commandId": {"type": "string"}, "projectId": {"type": "string"}, "previousRevision": {"type": "integer"}, "appliedRevision": {"type": "integer"}, "project": {"$ref": "./domain.schema.json#/$defs/Project"}, "issues": {"type": "array", "items": {"$ref": "./domain.schema.json#/$defs/ProgramIssue"}}, "reviewState": {"enum": ["NOT_REVIEWED", "STALE"]}, "eventCursor": {"type": "integer"}, "preview": {"type": "boolean"}, "affectedIntervals": {"type": "array", "items": {"allOf": [{"$ref": "./domain.schema.json#/$defs/Interval"}, {"type": "object", "required": ["reasons"], "properties": {"reasons": {"type": "array", "items": {"enum": ["video", "audio", "issues"]}}}}]}}}},
    "RenderPlanCreate": {"type": "object", "additionalProperties": false, "required": ["outputGrantId", "filename"], "properties": {"outputGrantId": {"type": "string"}, "filename": {"type": "string", "minLength": 1, "maxLength": 255}, "profile": {"enum": ["COMPATIBLE", "ARCHIVAL_LOSSLESS"]}, "width": {"type": "integer", "minimum": 16}, "height": {"type": "integer", "minimum": 16}, "frameRate": {"type": "number", "minimum": 1, "maximum": 240}}},
    "ReviewCreate": {"type": "object", "additionalProperties": false, "properties": {"acknowledgedWarnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "EventToken": {"type": "object", "additionalProperties": false, "required": ["token", "expiresInSeconds"], "properties": {"token": {"type": "string"}, "expiresInSeconds": {"type": "integer", "minimum": 1, "maximum": 60}}},
    "Suggestion": {"type": "object", "required": ["id", "status", "kind", "inputDigest", "algorithm", "algorithmVersion", "configDigest", "confidence", "evidence", "limitations"], "properties": {"id": {"type": "string"}, "status": {"enum": ["PENDING", "ACCEPTED", "REJECTED", "STALE", "SUPERSEDED"]}, "kind": {"enum": ["ALIGNMENT", "CLUSTER"]}, "inputDigest": {"type": "string"}, "algorithm": {"type": "string"}, "algorithmVersion": {"type": "string"}, "configDigest": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}}}},
    "List": {"type": "array", "items": {}},
    "Empty": {"type": "object", "maxProperties": 0}
  }
}
